PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# MongoDB Atlas - fill this in when ready.
MONGODB_URI=
MONGODB_DB_NAME=codeatlas
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# JWT secrets - use long random values locally.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Gmail SMTP - configure later.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

NOTIFICATION_POLL_INTERVAL_MS=60000

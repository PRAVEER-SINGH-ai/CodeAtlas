require("dotenv").config();

const app = require("./app");
const { startNotificationScheduler } = require("./jobs/notificationScheduler");

const PORT = process.env.PORT || 5000;

const server = app.listen(PORT, () => {
    console.log(`CodeAtlas server running on port ${PORT}`);

    // Scheduler waits for MongoDB before processing reminders.
    startNotificationScheduler();
});

process.on("SIGINT", () => {
    console.log("\nShutting down CodeAtlas server...");
    server.close(() => process.exit(0));
});
